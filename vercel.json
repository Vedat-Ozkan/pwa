{
  "rewrites": [
    {
      "source": "/((?!sw\\.js|workbox-.*\\.js|manifest\\.webmanifest|icon-.*\\.png|logo\\.png|registerSW\\.js|api\\/.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],
  "functions": {
    "api/generate-pdf.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/cleanup-storage.js": {
      "maxDuration": 60
    },
    "api/regenerate-pdfs.js": {
      "maxDuration": 60
    },
    "api/migrate-pdfs-to-r2.js": {
      "maxDuration": 60
    },
    "api/migrate-photos-to-r2.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cleanup-storage",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/migrate-pdfs-to-r2",
      "schedule": "30 8 * * *"
    }
  ]
}
